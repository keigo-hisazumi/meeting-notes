# ローカル開発用の Firebase 設定。このファイルを .env.local にコピーして値を入れる
# Firebase コンソールの「プロジェクトの設定」→「マイアプリ」の firebaseConfig を JSON で 1 行に書く
VITE_FIREBASE_CONFIG='{"apiKey":"","authDomain":"","projectId":"","appId":""}'

# true にすると Firebase Emulator Suite（Auth: 9099、Firestore: 8080）に接続する
VITE_FIREBASE_EMULATOR=false
